{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: gcc compilar arquivo ativo",
            "command": "bash",
            "args": [
                "-c",
                "mkdir -p '${fileDirname}/output' && /usr/bin/gcc -fdiagnostics-color=always -g '${file}' -o '${fileDirname}/output/${fileBasenameNoExtension}'"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Cria a pasta output e compila o binario no Linux."
        }
    ]
}
