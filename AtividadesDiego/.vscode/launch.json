{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: gcc Compilar e Depurar",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}/output/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Habilitar impressao formatada para gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: gcc compilar arquivo ativo",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
